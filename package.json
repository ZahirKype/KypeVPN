{
  "name": "kypevpn-electron",
  "version": "1.1.0",
  "description": "Privacy-first Cloudflare WARP client for Windows, built with Electron, React and WireGuard.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "node scripts/copy-preload.cjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder",
    "portable": "npm run build && node scripts/make-portable.cjs"
  },
  "keywords": [
    "vpn",
    "privacy",
    "wireguard",
    "kype"
  ],
  "author": "Kype Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.3",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "com.kype.vpn",
    "productName": "KypeVPN",
    "copyright": "KypeVPN",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "kype/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KypeVPN",
      "artifactName": "KypeVPN-Setup-${version}.${ext}"
    }
  }
}
